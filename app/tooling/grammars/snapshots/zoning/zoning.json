{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Zoning",
  "scopeName": "source.zoning",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#foldedReasons"
    },
    {
      "include": "#zones"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#globs"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.zoning",
          "begin": "//",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.zoning"
            }
          },
          "end": "$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.zoning",
          "begin": "\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.zoning"
            }
          },
          "end": "\"",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.zoning"
            }
          },
          "patterns": [
            {
              "name": "constant.character.escape.zoning",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "foldedReasons": {
      "patterns": [
        {
          "name": "string.unquoted.folded-reason.zoning",
          "match": "^\\s*(\\\\\\\\).*$",
          "captures": {
            "1": {
              "name": "punctuation.definition.string.zoning"
            }
          }
        }
      ]
    },
    "zones": {
      "comment": "A zone name is only a name because of where it sits, so the block has to be entered to see it - a flat rule would either miss it or claim the first word of every line in the file. The nested path block is entered by the same trick one level down, and closes on its own `}` before this rule ever tests for one.",
      "begin": "^\\s*(zones)\\s*(\\{)",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.zoning"
        },
        "2": {
          "name": "punctuation.section.block.zoning"
        }
      },
      "end": "^\\s*(\\})",
      "endCaptures": {
        "1": {
          "name": "punctuation.section.block.zoning"
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#pathBlock"
        },
        {
          "include": "#zoneName"
        },
        {
          "include": "#globs"
        }
      ]
    },
    "pathBlock": {
      "begin": "^\\s*([^\\s{}\"]+)\\s*(\\{)",
      "beginCaptures": {
        "1": {
          "name": "entity.name.section.zoning"
        },
        "2": {
          "name": "punctuation.section.block.zoning"
        }
      },
      "end": "^\\s*(\\})",
      "endCaptures": {
        "1": {
          "name": "punctuation.section.block.zoning"
        }
      },
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#globs"
        }
      ]
    },
    "zoneName": {
      "match": "^\\s*([^\\s{}\"]+)",
      "captures": {
        "1": {
          "name": "entity.name.section.zoning"
        }
      }
    },
    "declarations": {
      "patterns": [
        {
          "match": "^\\s*(package)\\s+([^\\s{]+)",
          "captures": {
            "1": {
              "name": "keyword.declaration.package.zoning"
            },
            "2": {
              "name": "entity.name.namespace.zoning"
            }
          }
        },
        {
          "match": "^\\s*(workspace)\\b",
          "captures": {
            "1": {
              "name": "keyword.declaration.workspace.zoning"
            }
          }
        },
        {
          "match": "^\\s*(member|seal|keep|use)\\s+([^\\s{]+)",
          "captures": {
            "1": {
              "name": "keyword.declaration.zoning"
            },
            "2": {
              "name": "entity.name.section.zoning"
            }
          }
        },
        {
          "match": "^\\s*(variance)\\s+(zone|seal|keep|cycle|reach|use|escape)\\b",
          "captures": {
            "1": {
              "name": "keyword.declaration.zoning"
            },
            "2": {
              "name": "support.type.law.zoning"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.zoning",
          "match": "\\b(?:package|workspace|member|root|language|facade|exclude|zones|seal|through|open|to|keep|nobody|use|by|limit|reach|hop|hops|forbid|cycles|across|directories|variance|because)\\b"
        },
        {
          "name": "support.type.law.zoning",
          "match": "\\b(?:zone|seal|keep|cycle|reach|use|escape)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.integer.zoning",
          "match": "\\b\\d+\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.zoning",
          "match": "->"
        },
        {
          "name": "punctuation.section.block.zoning",
          "match": "[{}]"
        }
      ]
    },
    "globs": {
      "patterns": [
        {
          "name": "string.unquoted.path.zoning",
          "match": "(?<!\\S)[^\\s{}\"]*(?:\\*\\*?|/)[^\\s{}\"]*"
        }
      ]
    }
  }
}
