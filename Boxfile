format = 2
kind = "package"
id = "diffpane"
version = "0.4.0"
description = "Browse and edit project files and watch Git changes as they happen."
platforms = ["macos-aarch64"]

[executables]
diffpane = "bin/diffpane"

[check]
command = "diffpane"
args = ["--check"]

[pack]
source = "release/box"
out = "release/diffpane-0.4.0.box"
include = ["bin/diffpane", "share/diffpane/Diffpane.app.zip"]

[publish]
registry = "https://box.billylives.com"
