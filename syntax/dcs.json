{
  "name": "Designcraft Script",
  "scopeName": "source.designcraft-script",
  "patterns": [
    {
      "match": "^\\s*#.*$",
      "name": "comment.line.number-sign.dcs"
    },
    {
      "begin": "^\\s*([A-Za-z_][\\w]*(?:\\.[A-Za-z_][\\w]*)*)\\s+",
      "beginCaptures": {
        "1": {
          "name": "entity.name.function.dcs"
        }
      },
      "end": "$",
      "patterns": [
        {
          "include": "source.json"
        }
      ]
    }
  ]
}
