{
  "name": "diffpane",
  "version": "0.4.0",
  "private": true,
  "description": "A quiet, live view of your working tree",
  "type": "module",
  "main": "app/electron/runtime/window/main.mjs",
  "scripts": {
    "build:icons": "node app/tooling/icons/build-icons.ts",
    "build": "vp run bundle",
    "start": "electron .",
    "test": "vp test",
    "install:app": "node app/tooling/distribution/install.ts",
    "setup:languages": "node app/tooling/dependencies/setup-languages.ts",
    "setup:howmany": "node app/tooling/dependencies/setup-howmany.ts",
    "test:languages": "node app/tests/tooling/languages/languages.integration.mjs",
    "prepare": "vp config --no-agent && node app/tooling/commands/emit-preload.ts && vp fmt app/electron/runtime/window/preload.cjs",
    "dev": "node app/tooling/commands/dev.ts",
    "preview": "vp preview",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "test:watch": "vp test watch",
    "test:docs": "vp test app/tests/tooling/quality/docs.test.mjs",
    "verify": "vp check && vp test && vp run bundle"
  },
  "dependencies": {
    "@parcel/watcher": "2.6.0",
    "basedpyright": "1.40.2",
    "diff": "9.0.0",
    "typescript": "6.0.3",
    "typescript-language-server": "6.0.2"
  },
  "devDependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@electron/packager": "20.3.0",
    "@shikijs/core": "4.5.0",
    "@shikijs/engine-oniguruma": "4.5.0",
    "@shikijs/langs": "4.5.0",
    "@shikijs/monaco": "4.5.0",
    "@shikijs/themes": "4.5.0",
    "@wooorm/starry-night": "3.11.0",
    "dompurify": "^3.4.17",
    "electron": "44.7.0",
    "linguist-languages": "9.5.0",
    "marked": "^18.1.1",
    "material-icon-theme": "5.39.0",
    "mermaid": "^12.2.0",
    "monaco-editor": "^0.57.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
    "vite-plus": "1.1.0",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0"
  },
  "engines": {
    "node": "^22.22.1 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "npm@11.19.1"
}
