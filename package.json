{
  "name": "diffpane",
  "version": "0.4.0",
  "private": true,
  "description": "A quiet, live view of your working tree",
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "build": "vite build",
    "start": "electron .",
    "test": "node --test tests/*.test.mjs",
    "test:app": "node tests/app.e2e.mjs && node tests/files.e2e.mjs && node tests/ide.e2e.mjs && node tests/configs.e2e.mjs",
    "install:app": "node install.mjs",
    "setup:languages": "node setup-languages.mjs",
    "test:languages": "node tests/languages.integration.mjs",
    "test:billy": "node tests/billy.integration.mjs"
  },
  "dependencies": {
    "@parcel/watcher": "2.6.0",
    "basedpyright": "1.40.2",
    "diff": "9.0.0",
    "typescript": "6.0.3",
    "typescript-language-server": "6.0.2"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@shikijs/core": "4.5.0",
    "@shikijs/engine-oniguruma": "4.5.0",
    "@shikijs/langs": "4.5.0",
    "@shikijs/monaco": "4.5.0",
    "@shikijs/themes": "4.5.0",
    "@wooorm/starry-night": "3.11.0",
    "electron": "44.7.0",
    "linguist-languages": "9.5.0",
    "material-icon-theme": "5.39.0",
    "monaco-editor": "^0.57.0",
    "playwright": "1.61.1",
    "vite": "8.3.4",
    "yaml": "^2.9.1"
  }
}
